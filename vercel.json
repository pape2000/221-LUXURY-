{
  "headers": [
    {
      "source": "/(index.html|static-index.html|gestionnaire|gestionnaire/)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/gestionnaire",
      "destination": "/gestionnaire-shell.html"
    },
    {
      "source": "/gestionnaire/",
      "destination": "/gestionnaire-shell.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null
}
