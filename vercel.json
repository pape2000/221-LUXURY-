{
  "rewrites": [
    {
      "source": "/gestionnaire",
      "destination": "/gestionnaire-shell.html"
    },
    {
      "source": "/gestionnaire/",
      "destination": "/gestionnaire-shell.html"
    },
    {
      "source": "/",
      "destination": "/api/public"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
